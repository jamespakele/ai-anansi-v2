# ── Required ──────────────────────────────────────────────────────────────────
# Strong random password for the local PostgreSQL container.
# Generate one with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-to-something-strong

# ── LLM (pick ONE option below) ───────────────────────────────────────────────

# Option A: Gemini API key (free tier at https://ai.google.dev)
# Set backend = "gemini" in anansi.toml (or anansi/anansi.toml)
ANANSI_GEMINI_API_KEY=

# Option B: OpenRouter API key (access to many models, https://openrouter.ai)
# Set backend = "openrouter" in anansi.toml
ANANSI_OPENROUTER_API_KEY=

# Option C: Ollama installed locally (free, no API key needed)
# Install from https://ollama.com — then pull a model:
#   ollama pull qwen2.5:14b
# Set in anansi.toml:
#   backend = "ollama"
#   url     = "http://host.docker.internal:11434"
#   model   = "qwen2.5:14b"
# No env var needed — Ollama runs on your machine, the container reaches it via
# host.docker.internal (configured in docker-compose.local.yml).

# ── Optional ──────────────────────────────────────────────────────────────────
# Token required to call the MCP server from outside (Claude Cowork will send
# this as Bearer auth). Leave empty to disable auth (not recommended publicly).
ANANSI_SKILL_TOKEN=
