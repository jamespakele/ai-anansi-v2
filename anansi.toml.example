[paths]
web_dir = "anansi/web"
rules_dir = "anansi/%Rules"
templates_dir = "anansi/templates"
db_file = "anansi/web.db"

[llm]
backend = "ollama"
url = "http://localhost:11434"
model = "qwen2.5:14b"
n_ctx = 16384
timeout_s = 600

[llm.decomposition]
temperature = 0.2
max_tokens = 4096
json_mode = false

[llm.extraction]
temperature = 0.2
max_tokens = 4096
json_mode = true

[llm.synthesis]
temperature = 0.5
max_tokens = 8192
json_mode = false

[server]
mcp_port = 3738
host = "0.0.0.0"
read_only = false
# api_key = "kip_ak_..."              # optional; enforce auth on all MCP requests
                                      # accepted as: Authorization: Bearer <key>
                                      # or query param: ?api_key=<key>
                                      # override at runtime: export ANANSI_API_KEY=...

# ─── Gemini backend ───────────────────────────────────────────────────────────
# backend = "gemini" checks for the gemini CLI first (Google OAuth / subscription quota).
# If the CLI is absent and api_key is set, it falls back to direct Gemini REST.
# Recommended: install the Gemini CLI and leave api_key commented out.
#
# [llm.gemini]
# cli_path = "/usr/local/bin/gemini"   # omit to search PATH
# model = "gemini-2.5-pro"
# api_key = "AIza..."                  # REST fallback only; CLI uses OAuth
# timeout_s = 300

# ─── OpenRouter backend ───────────────────────────────────────────────────────
# backend = "openrouter" gives access to virtually every frontier model via one
# API key (Gemini, Claude, GPT-4, Mistral, etc.).  Recommended fallback when the
# Gemini CLI is unavailable.  Model strings are provider-namespaced.
#
# [llm.openrouter]
# api_key = "sk-or-..."                # or export ANANSI_OPENROUTER_API_KEY
# model = "google/gemini-2.5-pro"      # examples: "anthropic/claude-opus-4-7"
# base_url = "https://openrouter.ai/api/v1"   # default; omit unless self-hosted
# timeout_s = 300

# ─── Pipeline mode ────────────────────────────────────────────────────────────
# "batch" collapses N Pass-3 calls + 1 Pass-4 call into a single combined call.
# Use with frontier models that have large context windows (Gemini 2.5 Pro, etc.).
# Omit or set to "standard" to use the default per-leaf pipeline.
#
# [pipeline]
# mode = "batch"     # enable batch mode
# mode = "standard"  # explicit default; same as omitting this section

# ─── Codex CLI backend (OpenAI device-auth / subscription) ───────────────────
# backend = "codex" shells out to the OpenAI Codex CLI. Authenticate once with
# `codex auth login` (device-flow OAuth). Requires a ChatGPT Plus/Pro subscription.
# Token stored in ~/.codex/. No API key in .env needed.
# Set ANANSI_CODEX_CLI_PATH to override the binary path if not in PATH.
#
# [llm]
# backend = "codex"
# timeout_s = 300

# ─── Inbox watcher ────────────────────────────────────────────────────────────
# When enabled, a background Tokio task watches `watch_dir` every `poll_interval_secs`.
# Each .md or .txt file is run through the full pipeline:
#   Stage 1a: para-projects-areas  (parallel)
#   Stage 1b: para-resource-entities  (parallel)
#   Stage 2:  sb-atomize
#   Stage 3:  ingest_atomized → PostgreSQL
#
# Skills are baked into the image at /app/skills (from llm/plugins via the Dockerfile).
# Prod reads /app/skills (the default skills_dir) — no bind mount; rebuild the image to
# update skills. For local-dev live editing, docker-compose.local.yml mounts
# ./llm/plugins/anansi.plugin/skills -> /data/skills; set skills_dir = "/data/skills" there.
#
# [inbox]
# enabled = true
# watch_dir = "/data/inbox"
# archive_dir = "/data/archive"
# poll_interval_secs = 30
# skills_dir = "/data/skills"      # mount point for r2-anansi.plugin/
# llm_backend = "gemini"           # "gemini" | "openrouter" | "codex" | "ollama"


# ─── LLM-Wiki (Build-12) ──────────────────────────────────────────────────────
# A file-native projection of the knowledge graph following the Karpathy
# llm-wiki pattern. When enabled, every successful capture is DUAL-WRITTEN: it
# still writes PostgreSQL (the source of truth), then projects the affected
# notes from canonical DB rows into markdown files under `dir`:
#   <slug>.<entity_type>.md   one file per note (YAML frontmatter + [[wikilinks]])
#   index.md                  catalog of all notes, grouped by entity_type
#   log.md                    append-only ingest journal
#
# Wiki writes are non-authoritative and non-fatal: a failure is logged and never
# rolls back or fails the underlying DB write.
#
# `dir` — where the wiki files live. A leading `~`/`~/` expands to the OS home
# (`$HOME` on Linux/macOS, `%USERPROFILE%` on Windows), so `~/llm-wiki` resolves
# to /home/<user>/llm-wiki, /Users/<user>/llm-wiki, or C:\Users\<user>\llm-wiki.
# Default: `~/llm-wiki` (local, Obsidian-readable, beside your PARA folders).
#   • Local install: keep `~/llm-wiki`. Rebuild from Postgres with `anansi2 wiki init`
#     (or `anansi2 wiki rebuild` to wipe + regenerate).
#   • Containerized (Docker): set `dir = "/data/llm-wiki"` so it lands on the
#     ./data:/data persistent mount (the container's home is not persisted). For a
#     LOCAL copy from a remote/VPS anansi, use the `anansi-init-wiki` skill instead.
#
# anansi-crawl (Build-13): a background maintenance pass that reconciles the wiki
# against canonical Postgres state — recreates missing/stale note files, rebuilds
# index.md, and garbage-collects orphan files no live note backs. Also runnable
# on demand via the `anansi_wiki_crawl` MCP tool. Requires enabled = true.
#
# LLM semantic lint (Build-14): an analysis phase of the crawl that asks the
# configured LLM to flag contradictions (sets has_conflicts), stale claims,
# under-linked notes, and data gaps — writing a browsable lint.md. Incremental
# (only notes changed since the last run, capped at lint_batch_max per pass) so
# cost stays bounded. Requires enabled = true and an LLM backend. Also runnable
# on demand via the `anansi_wiki_lint` MCP tool.
#
# Tipping-point eviction (Build-15): bound the wiki to the hottest notes. The
# crawl keeps the most-recently-accessed notes that fit under max_mb (total size)
# and/or max_notes (file count) — whichever cap is hit first — and evicts the
# rest (deletes their files). Eviction is lossless: evicted notes still resolve
# via anansi_get/search from Postgres; reading one re-warms it for the next crawl.
# Both default to 0 = unlimited.
#
# [wiki]
# enabled = true
# dir = "~/llm-wiki"          # local default; containers: "/data/llm-wiki"
# crawl_enabled = true
# crawl_interval_secs = 3600
# lint_enabled = true
# lint_batch_max = 25
# max_mb = 100        # 0 = unlimited
# max_notes = 5000    # 0 = unlimited
