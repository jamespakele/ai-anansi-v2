# ── Required ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-to-something-strong

# ── LLM — pick ONE ────────────────────────────────────────────────────────────

# Option A: Gemini API key (free tier — https://ai.google.dev)
# Set backend = "gemini" in data/anansi/anansi.toml
ANANSI_GEMINI_API_KEY=

# Option B: OpenRouter API key (https://openrouter.ai)
# Set backend = "openrouter" in data/anansi/anansi.toml
ANANSI_OPENROUTER_API_KEY=

# Option C: Ollama installed on your machine — no API key needed
# Install from https://ollama.com, then: ollama pull qwen2.5:14b
# Set in data/anansi/anansi.toml:
#   backend = "ollama"
#   url     = "http://host.docker.internal:11434"
#   model   = "qwen2.5:14b"

# ── Optional ──────────────────────────────────────────────────────────────────
ANANSI_SKILL_TOKEN=
