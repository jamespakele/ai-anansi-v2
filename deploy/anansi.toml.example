[paths]
# All path fields have sensible defaults — section must be present but can be empty.

[server]
mcp_port = 3738
host = "0.0.0.0"

# ─── LLM backend ──────────────────────────────────────────────────────────────
# Choose ONE backend. Set the corresponding key in .env.

# Option A — Gemini API (recommended, free tier available)
# Get a key at https://ai.google.dev
# Set ANANSI_GEMINI_API_KEY in .env
[llm]
backend = "gemini"
timeout_s = 300

[llm.gemini]
model = "gemini-2.5-pro"

# Option B — OpenRouter (access to many models via one key)
# Set ANANSI_OPENROUTER_API_KEY in .env, then switch backend below.
#
# [llm]
# backend = "openrouter"
# timeout_s = 300
#
# [llm.openrouter]
# model = "google/gemini-2.5-pro"

# Option C — Ollama (fully local, no API key needed)
# Requires Ollama installed on your machine with qwen2.5:14b pulled.
# docker-compose.local.yml already adds the host.docker.internal mapping.
#
# [llm]
# backend = "ollama"
# url = "http://host.docker.internal:11434"
# model = "qwen2.5:14b"
# timeout_s = 600

# ─── Inbox watcher ────────────────────────────────────────────────────────────
# Drop .md or .txt files into the inbox folder — Anansi picks them up within
# poll_interval_secs, runs the full pipeline, and ingests into PostgreSQL.
# Skills are baked into the image at /app/skills — no extra setup needed.
[inbox]
enabled = true
watch_dir = "/data/inbox"
archive_dir = "/data/archive"
poll_interval_secs = 30
llm_backend = "gemini"
