/target

# Environment files — never commit secrets
.env
.env.*
!.env.example

# Vault — ignore notes and runtime files, but keep anansi.toml
/vault/anansi/web/
/vault/anansi/web.db
/vault/anansi/web.db-shm
/vault/anansi/web.db-wal
/vault/*.md
/vault/**/*.md
!vault/anansi/anansi.toml
*.db
*.db-shm
*.db-wal
*.tmp

# cowork-generated error reports
error-report*.md

# test fixture data (real documents, not for git)
/tests/fixtures

# bmad framework & agent tooling
/.agent
/.agents
/.claude
/.gemini
/.opencode
/_bmad
